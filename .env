# Configuration settings for Autonomous Job Hunter
# Ollama local inference endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# SearXNG local meta-search endpoint
SEARXNG_BASE_URL=http://localhost:8081

# Logging and Execution Defaults
LOG_LEVEL=INFO
DEFAULT_TARGET_JOBS=10
DEFAULT_MAX_ITERATIONS=5
DEFAULT_EVALUATION_THRESHOLD=70
